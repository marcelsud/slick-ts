{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "fixture-dependency": ["packages/fixture-dependency"],
      "declaration-only": ["packages/declaration-only"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
